# syntax=docker/dockerfile:1
# Optional: --secret id=ca,src=<bundle.crt> for builds behind a TLS-intercepting proxy (not stored in the image).
# Stage 1: build the React dashboard (used for the Canvas iframe and standalone access)
FROM node:22-alpine AS web
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export NODE_EXTRA_CA_CERTS=/run/secrets/ca; fi; \
    npm ci --no-audit --no-fund
COPY web/ ./
RUN npx vite build

# Stage 2: model training + API
FROM python:3.11-slim
WORKDIR /app
RUN --mount=type=secret,id=ca,required=false \
    if [ -f /run/secrets/ca ]; then export PIP_CERT=/run/secrets/ca; fi; \
    pip install --no-cache-dir pandas numpy scikit-learn xgboost shap lime flask pyjwt joblib gunicorn
COPY ml/ ml/
COPY api/ api/
COPY --from=web /web/dist web/dist
COPY docker/entrypoint.sh /entrypoint.sh
ENV ARTIFACTS_DIR=/app/artifacts STATIC_DIR=/app/web/dist
EXPOSE 8000
ENTRYPOINT ["/bin/sh", "/entrypoint.sh"]
